@model IEnumerable<SIMS.DatabaseContext.Entities.Submission>

@{
    ViewData["Title"] = "Student Submissions";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="mb-4">
    <h1 class="h3 mb-1">Student Submissions</h1>

    <p class="text-muted">
        Assignment:
        <strong>@ViewBag.AssignmentTitle</strong>
        |
        Course:
        <strong>@ViewBag.CourseName</strong>
    </p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<div class="card">
    <div class="card-body">

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Student Code</th>
                        <th>Student Name</th>
                        <th>Submitted At</th>
                        <th>PDF File</th>
                        <th>Score</th>
                        <th>Feedback</th>
                        <th style="width: 190px;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7"
                                class="text-center text-muted">
                                No student submissions found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @(item.Student?.StudentCode ?? "N/A")
                                </td>

                                <td>
                                    @(item.Student?.FullName ?? "N/A")
                                </td>

                                <td>
                                    @item.SubmittedAt.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    @item.OriginalFileName
                                </td>

                                <td>
                                    @if (item.Score.HasValue)
                                    {
                                        <span class="badge bg-success">
                                            @item.Score.Value.ToString("0.##")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Not graded
                                        </span>
                                    }
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Feedback)
                                        ? "-"
                                        : item.Feedback)
                                </td>

                                <td>
                                    <a asp-action="Download"
                                       asp-route-id="@item.Id"
                                       class="btn btn-success btn-sm">
                                        Download
                                    </a>

                                    <a asp-action="Grade"
                                       asp-route-id="@item.Id"
                                       class="btn btn-primary btn-sm">
                                        Grade
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>

            </table>
        </div>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>

    </div>
</div>