@model SIMS.DatabaseContext.Entities.Course
@{
    ViewData["Title"] = "Delete Course";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="card">
    <div class="card-body">
        <h1 class="h3 mb-3 text-danger">Delete Course</h1>
        <h4>Are you sure you want to delete this course?</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">Course Code</dt>
            <dd class="col-sm-9">@Model.CourseCode</dd>

            <dt class="col-sm-3">Course Name</dt>
            <dd class="col-sm-9">@Model.CourseName</dd>

            <dt class="col-sm-3">Credits</dt>
            <dd class="col-sm-9">@Model.Credits</dd>

            <dt class="col-sm-3">Max Students</dt>
            <dd class="col-sm-9">@Model.MaxStudents</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>