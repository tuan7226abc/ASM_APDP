@model SIMS.DatabaseContext.Entities.Course

@{
    ViewData["Title"] = "Delete Course";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="mb-4">
    <h1 class="h3 mb-1">Delete Course</h1>

    <p class="text-danger mb-0">
        Are you sure you want to delete this course?
    </p>
</div>

<div class="card">
    <div class="card-body">

        <dl class="row mb-4">

            <dt class="col-sm-3">
                Course Code
            </dt>

            <dd class="col-sm-9">
                @Model.CourseCode
            </dd>

            <dt class="col-sm-3">
                Course Name
            </dt>

            <dd class="col-sm-9">
                @Model.CourseName
            </dd>

            <dt class="col-sm-3">
                Credits
            </dt>

            <dd class="col-sm-9">
                @Model.Credits
            </dd>

            <dt class="col-sm-3">
                Maximum Students
            </dt>

            <dd class="col-sm-9">
                @Model.MaxStudents
            </dd>

        </dl>

        <div class="alert alert-warning">
            Deleting this course will also delete related enrollments,
            schedules, attendance records, grades, assignments and submissions.
        </div>

        <form asp-controller="Course"
              asp-action="Delete"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="id"
                   value="@Model.Id" />

            <button type="submit"
                    class="btn btn-danger"
                    onclick="return confirm('Delete this course and all related data?');">
                Delete
            </button>

            <a asp-controller="Course"
               asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>