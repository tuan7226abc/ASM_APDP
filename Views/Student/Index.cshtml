@model IEnumerable<SIMS.DatabaseContext.Entities.Student>

@{
    ViewData["Title"] = "Student List";
    Layout = "~/Views/Shared/_MainLayout.cshtml";

    int studentCount = Model?.Count() ?? 0;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/student-pages.css"
          asp-append-version="true" />
}

<div class="student-page">

    <div class="student-page-header">

        <div>
            <h1 class="student-page-title">
                Student Management
            </h1>

            <p class="student-page-description">
                View, create, update and manage student information
            </p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Student"
               asp-action="Create"
               class="student-add-button">

                <i data-feather="user-plus"></i>

                Add New Student
            </a>
        }

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show student-alert"
             role="alert">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show student-alert"
             role="alert">

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <div class="student-card">

        <div class="student-card-header">

            <h2 class="student-card-title">
                Student List
            </h2>

            <span class="student-count-badge">
                <i data-feather="users"></i>

                @studentCount student@(studentCount == 1 ? "" : "s")
            </span>

        </div>

        <div class="student-table-wrapper">

            <table class="student-table">

                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Email</th>
                        <th>Date of Birth</th>
                        <th>Gender</th>
                        <th>Phone</th>
                        <th>Address</th>
                        <th>User ID</th>
                        <th>Status</th>

                        @if (User.IsInRole("Admin"))
                        {
                            <th>Actions</th>
                        }
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            string initials = string.Empty;

                            if (!string.IsNullOrWhiteSpace(item.FullName))
                            {
                                var nameParts = item.FullName
                                    .Split(
                                        ' ',
                                        StringSplitOptions.RemoveEmptyEntries);

                                initials = nameParts.Length >= 2
                                    ? $"{nameParts[0][0]}{nameParts[^1][0]}"
                                    : nameParts[0][0].ToString();

                                initials = initials.ToUpper();
                            }

                            <tr>

                                <td class="student-name-cell">

                                    <div class="student-name-wrapper">

                                        <div class="student-avatar">
                                            @initials
                                        </div>

                                        <div>
                                            <div class="student-name">
                                                @item.FullName
                                            </div>

                                            <div class="student-code">
                                                @item.StudentCode
                                            </div>
                                        </div>

                                    </div>

                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Email)
                                        ? "-"
                                        : item.Email)
                                </td>

                                <td>
                                    @(item.DateOfBirth.HasValue
                                        ? item.DateOfBirth.Value.ToString("dd/MM/yyyy")
                                        : "-")
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Gender)
                                        ? "-"
                                        : item.Gender)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Phone)
                                        ? "-"
                                        : item.Phone)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Address)
                                        ? "-"
                                        : item.Address)
                                </td>

                                <td>
                                    @(item.UserId.HasValue
                                        ? item.UserId.Value.ToString()
                                        : "-")
                                </td>

                                <td>
                                    <span class="student-status">
                                        Active
                                    </span>
                                </td>

                                @if (User.IsInRole("Admin"))
                                {
                                    <td>

                                        <div class="student-action-group">

                                            <a asp-controller="Student"
                                               asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="student-action student-action-edit"
                                               title="Edit student">

                                                <i data-feather="edit-2"></i>
                                            </a>

                                            <a asp-controller="Student"
                                               asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="student-action student-action-delete"
                                               title="Delete student">

                                                <i data-feather="trash-2"></i>
                                            </a>

                                            <a asp-controller="Student"
                                               asp-action="Enroll"
                                               asp-route-id="@item.Id"
                                               class="student-action student-action-enroll"
                                               title="Enroll student">

                                                <i data-feather="book-open"></i>
                                            </a>

                                        </div>

                                    </td>
                                }

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9"
                                class="student-empty">

                                <div class="student-empty-icon">
                                    <i data-feather="users"></i>
                                </div>

                                <h3 class="student-empty-title">
                                    No students found
                                </h3>

                                <p class="student-empty-text">
                                    Add a new student to begin managing student records.
                                </p>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            if (window.feather) {
                feather.replace();
            }
        });
    </script>
}