@model List<SIMS.DatabaseContext.Entities.Student>

@{
    ViewData["Title"] = "Student List";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<h2>Student List</h2>

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary mb-3">
            Add New Student
        </a>
    </p>
}

<table class="table table-bordered table-hover table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Student Code</th>
            <th>Full Name</th>
            <th>Email</th>
            <th>Date of Birth</th>
            <th>Gender</th>
            <th>Phone</th>
            <th>Address</th>
            <th>User ID</th>
            <th>Created At</th>
            <th>Updated At</th>
            <th width="220">Actions</th>
        </tr>
    </thead>

    <tbody>

        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>

                    <td>@item.Id</td>

                    <td>@item.StudentCode</td>

                    <td>@item.FullName</td>

                    <td>@item.Email</td>

                    <td>
                        @(item.DateOfBirth.HasValue
                            ? item.DateOfBirth.Value.ToString("dd/MM/yyyy")
                            : "")
                    </td>

                    <td>@item.Gender</td>

                    <td>@item.Phone</td>

                    <td>@item.Address</td>

                    <td>@item.UserId</td>

                    <td>
                        @(item.CreatedAt.HasValue
                            ? item.CreatedAt.Value.ToString("dd/MM/yyyy HH:mm")
                            : "")
                    </td>

                    <td>
                        @(item.UpdatedAt.HasValue
                            ? item.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")
                            : "")
                    </td>

                    <td>

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-warning btn-sm">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-danger btn-sm">
                                Delete
                            </a>
                        }

                        @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
                        {
                            <a asp-action="Enroll"
                               asp-route-id="@item.Id"
                               class="btn btn-success btn-sm">
                                Enroll
                            </a>
                        }

                    </td>

                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="12" class="text-center">
                    No students found.
                </td>
            </tr>
        }

    </tbody>

</table>