@model SIMS.DatabaseContext.Entities.Schedule

@{
    ViewData["Title"] = "Add Schedule";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/schedule-pages.css"
          asp-append-version="true" />
}

<div class="schedule-page">

    <!-- PAGE HEADER -->
    <div class="schedule-page-header">

        <div>
            <h1 class="schedule-page-title">
                Add Schedule
            </h1>

            <p class="schedule-page-description">
                Create a new timetable entry for a course and teacher
            </p>
        </div>

        <a asp-controller="Schedule"
           asp-action="Index"
           class="schedule-back-button">

            <i data-feather="arrow-left"></i>
            Back to Schedule List
        </a>

    </div>

    <!-- FORM CARD -->
    <div class="schedule-form-card">

        <form asp-controller="Schedule"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger schedule-alert">
            </div>

            <!-- COURSE AND TEACHER -->
            <div class="schedule-form-section">

                <div class="schedule-form-section-title">

                    <span class="schedule-form-section-icon">
                        <i data-feather="book-open"></i>
                    </span>

                    Course Assignment
                </div>

                <div class="schedule-form-grid">

                    <!-- COURSE -->
                    <div class="schedule-form-group">

                        <label asp-for="CourseId"
                               class="schedule-form-label">

                            Course
                            <span class="schedule-required">*</span>
                        </label>

                        <select asp-for="CourseId"
                                asp-items="ViewBag.CourseId"
                                class="schedule-form-control">

                            <option value="">
                                -- Select Course --
                            </option>
                        </select>

                        <span asp-validation-for="CourseId"
                              class="schedule-validation">
                        </span>

                    </div>

                    <!-- TEACHER -->
                    <div class="schedule-form-group">

                        <label asp-for="TeacherId"
                               class="schedule-form-label">

                            Teacher
                            <span class="schedule-required">*</span>
                        </label>

                        <select asp-for="TeacherId"
                                asp-items="ViewBag.TeacherId"
                                class="schedule-form-control">

                            <option value="">
                                -- Select Teacher --
                            </option>
                        </select>

                        <span asp-validation-for="TeacherId"
                              class="schedule-validation">
                        </span>

                    </div>

                </div>

            </div>

            <!-- TIME INFORMATION -->
            <div class="schedule-form-section">

                <div class="schedule-form-section-title">

                    <span class="schedule-form-section-icon">
                        <i data-feather="clock"></i>
                    </span>

                    Time Information
                </div>

                <div class="schedule-form-grid schedule-form-grid-three">

                    <!-- DAY OF WEEK -->
                    <div class="schedule-form-group">

                        <label asp-for="DayOfWeek"
                               class="schedule-form-label">

                            Day of Week
                            <span class="schedule-required">*</span>
                        </label>

                        <select asp-for="DayOfWeek"
                                class="schedule-form-control">

                            <option value="0">
                                -- Select Day --
                            </option>

                            <option value="1">Monday</option>
                            <option value="2">Tuesday</option>
                            <option value="3">Wednesday</option>
                            <option value="4">Thursday</option>
                            <option value="5">Friday</option>
                            <option value="6">Saturday</option>
                            <option value="7">Sunday</option>

                        </select>

                        <span asp-validation-for="DayOfWeek"
                              class="schedule-validation">
                        </span>

                    </div>

                    <!-- START TIME -->
                    <div class="schedule-form-group">

                        <label asp-for="StartTime"
                               class="schedule-form-label">

                            Start Time
                            <span class="schedule-required">*</span>
                        </label>

                        <input asp-for="StartTime"
                               type="time"
                               class="schedule-form-control" />

                        <span asp-validation-for="StartTime"
                              class="schedule-validation">
                        </span>

                    </div>

                    <!-- END TIME -->
                    <div class="schedule-form-group">

                        <label asp-for="EndTime"
                               class="schedule-form-label">

                            End Time
                            <span class="schedule-required">*</span>
                        </label>

                        <input asp-for="EndTime"
                               type="time"
                               class="schedule-form-control" />

                        <span asp-validation-for="EndTime"
                              class="schedule-validation">
                        </span>

                    </div>

                </div>

            </div>

            <!-- LOCATION AND DATE RANGE -->
            <div class="schedule-form-section">

                <div class="schedule-form-section-title">

                    <span class="schedule-form-section-icon">
                        <i data-feather="map-pin"></i>
                    </span>

                    Location and Date Range
                </div>

                <div class="schedule-form-grid schedule-form-grid-three">

                    <!-- ROOM -->
                    <div class="schedule-form-group">

                        <label asp-for="Room"
                               class="schedule-form-label">
                            Room
                        </label>

                        <input asp-for="Room"
                               class="schedule-form-control"
                               placeholder="Example: A101" />

                        <span asp-validation-for="Room"
                              class="schedule-validation">
                        </span>

                    </div>

                    <!-- START DATE -->
                    <div class="schedule-form-group">

                        <label asp-for="StartDate"
                               class="schedule-form-label">

                            Start Date
                            <span class="schedule-required">*</span>
                        </label>

                        <input asp-for="StartDate"
                               type="date"
                               class="schedule-form-control" />

                        <span asp-validation-for="StartDate"
                              class="schedule-validation">
                        </span>

                    </div>

                    <!-- END DATE -->
                    <div class="schedule-form-group">

                        <label asp-for="EndDate"
                               class="schedule-form-label">

                            End Date
                            <span class="schedule-required">*</span>
                        </label>

                        <input asp-for="EndDate"
                               type="date"
                               class="schedule-form-control" />

                        <span asp-validation-for="EndDate"
                              class="schedule-validation">
                        </span>

                    </div>

                </div>

            </div>

            <!-- ACTION BUTTONS -->
            <div class="schedule-form-actions">

                <button type="submit"
                        class="schedule-save-button">

                    <i data-feather="save"></i>
                    Save Schedule
                </button>

                <a asp-controller="Schedule"
                   asp-action="Index"
                   class="schedule-back-button">

                    <i data-feather="x"></i>
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            if (window.feather) {
                feather.replace();
            }
        });
    </script>
}