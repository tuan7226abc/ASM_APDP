@model IEnumerable<SIMS.DatabaseContext.Entities.Schedule>

@{
    ViewData["Title"] = "Schedule Management";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="mb-4">
    <h1 class="h3 mb-1">Schedule Management</h1>
    <p class="text-muted">Manage course timetables</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<div class="card">
    <div class="card-body">

        <div class="mb-3">
            <a asp-action="Create"
               class="btn btn-primary">
                Add Schedule
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Course</th>
                        <th>Teacher</th>
                        <th>Day</th>
                        <th>Time</th>
                        <th>Room</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th style="width: 160px;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8"
                                class="text-center text-muted">
                                No schedules found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            string dayName = item.DayOfWeek switch
                            {
                                2 => "Monday",
                                3 => "Tuesday",
                                4 => "Wednesday",
                                5 => "Thursday",
                                6 => "Friday",
                                7 => "Saturday",
                                8 => "Sunday",
                                _ => "Unknown"
                            };

                            <tr>
                                <td>
                                    @(item.Course?.CourseName ?? "N/A")
                                </td>

                                <td>
                                    @(item.Teacher?.FullName ?? "N/A")
                                </td>

                                <td>@dayName</td>

                                <td>
                                    @item.StartTime.ToString(@"hh\:mm")
                                    -
                                    @item.EndTime.ToString(@"hh\:mm")
                                </td>

                                <td>@item.Room</td>

                                <td>
                                    @(item.StartDate?.ToString("dd/MM/yyyy") ?? "-")
                                </td>

                                <td>
                                    @(item.EndDate?.ToString("dd/MM/yyyy") ?? "-")
                                </td>

                                <td>
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm">
                                        Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>