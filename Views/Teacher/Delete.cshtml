@model SIMS.DatabaseContext.Entities.Teacher

@{
    ViewData["Title"] = "Delete Teacher";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="mb-4">
    <h1 class="h3 mb-1">Delete Teacher</h1>

    <p class="text-danger mb-0">
        Are you sure you want to delete this teacher?
    </p>
</div>

<div class="card">
    <div class="card-body">

        <dl class="row mb-4">

            <dt class="col-sm-3">
                Teacher Code
            </dt>

            <dd class="col-sm-9">
                @Model.TeacherCode
            </dd>

            <dt class="col-sm-3">
                Full Name
            </dt>

            <dd class="col-sm-9">
                @Model.FullName
            </dd>

            <dt class="col-sm-3">
                Email
            </dt>

            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(Model.Email)
                    ? "-"
                    : Model.Email)
            </dd>

            <dt class="col-sm-3">
                Phone
            </dt>

            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(Model.Phone)
                    ? "-"
                    : Model.Phone)
            </dd>

            <dt class="col-sm-3">
                Department
            </dt>

            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(Model.Department)
                    ? "-"
                    : Model.Department)
            </dd>

        </dl>

        <div class="alert alert-warning">
            Deleting this teacher also deletes linked schedules,
            attendances, assignments, submissions, grades and account data.
        </div>

        <form asp-controller="Teacher"
              asp-action="Delete"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="id"
                   value="@Model.Id" />

            <button type="submit"
                    class="btn btn-danger"
                    onclick="return confirm('Delete this teacher and all related data?');">
                Delete
            </button>

            <a asp-controller="Teacher"
               asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>