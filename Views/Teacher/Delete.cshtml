@model SIMS.DatabaseContext.Entities.Teacher

@{
    ViewData["Title"] = "Delete Teacher";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="card">
    <div class="card-body">
        <h2 class="text-danger">Delete Teacher</h2>

        <div class="alert alert-warning">
            Are you sure you want to delete this teacher?
        </div>

        <dl class="row">
            <dt class="col-sm-3">Teacher Code</dt>
            <dd class="col-sm-9">@Model.TeacherCode</dd>

            <dt class="col-sm-3">Full Name</dt>
            <dd class="col-sm-9">@Model.FullName</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@Model.Phone</dd>

            <dt class="col-sm-3">Department</dt>
            <dd class="col-sm-9">@Model.Department</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn btn-danger">
                Delete
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>
        </form>
    </div>
</div>