@model IEnumerable<SIMS.DatabaseContext.Entities.Grade>

@{
    ViewData["Title"] = "My Grades";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="mb-4">
    <h1 class="h3 mb-1">My Grades</h1>

    <p class="text-muted">
        Grade results of
        <strong>@ViewBag.StudentName</strong>
    </p>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<div class="card">
    <div class="card-body">

        <div class="alert alert-info">
            Total score = Assignment 20% + Midterm 30% + Final 50%
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Course</th>
                        <th>Teacher</th>
                        <th>Assignment</th>
                        <th>Midterm</th>
                        <th>Final</th>
                        <th>Total</th>
                        <th>Result</th>
                        <th>Note</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8"
                                class="text-center text-muted">
                                No grades have been published.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var grade in Model)
                        {
                            string result;

                            if (!grade.TotalScore.HasValue)
                            {
                                result = "Not completed";
                            }
                            else if (grade.TotalScore >= 5)
                            {
                                result = "Pass";
                            }
                            else
                            {
                                result = "Fail";
                            }

                            <tr>
                                <td>
                                    @(grade.Course?.CourseName ?? "N/A")
                                </td>

                                <td>
                                    @(grade.Teacher?.FullName ?? "N/A")
                                </td>

                                <td>
                                    @(grade.AssignmentScore?.ToString("0.00") ?? "-")
                                </td>

                                <td>
                                    @(grade.MidtermScore?.ToString("0.00") ?? "-")
                                </td>

                                <td>
                                    @(grade.FinalScore?.ToString("0.00") ?? "-")
                                </td>

                                <td>
                                    <strong>
                                        @(grade.TotalScore?.ToString("0.00") ?? "-")
                                    </strong>
                                </td>

                                <td>
                                    @if (result == "Pass")
                                    {
                                        <span class="badge bg-success">
                                            Pass
                                        </span>
                                    }
                                    else if (result == "Fail")
                                    {
                                        <span class="badge bg-danger">
                                            Fail
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Not completed
                                        </span>
                                    }
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(grade.Note)
                                        ? "-"
                                        : grade.Note)
                                </td>
                            </tr>
                        }
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>