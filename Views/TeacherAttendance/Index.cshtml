@model IEnumerable<SIMS.DatabaseContext.Entities.Schedule>

@{
    ViewData["Title"] = "My Teaching Schedules";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="mb-4">
    <h1 class="h3 mb-1">Attendance Management</h1>

    <p class="text-muted">
        Select one of your teaching schedules to take attendance
    </p>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="card">
    <div class="card-body">

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Course</th>
                        <th>Day</th>
                        <th>Time</th>
                        <th>Room</th>
                        <th>Teaching period</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6"
                                class="text-center text-muted">
                                No teaching schedules found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            string dayName = item.DayOfWeek switch
                            {
                                2 => "Monday",
                                3 => "Tuesday",
                                4 => "Wednesday",
                                5 => "Thursday",
                                6 => "Friday",
                                7 => "Saturday",
                                8 => "Sunday",
                                _ => "Unknown"
                            };

                            <tr>
                                <td>
                                    @(item.Course?.CourseName ?? "N/A")
                                </td>

                                <td>@dayName</td>

                                <td>
                                    @item.StartTime.ToString(@"hh\:mm")
                                    -
                                    @item.EndTime.ToString(@"hh\:mm")
                                </td>

                                <td>@item.Room</td>

                                <td>
                                    @(item.StartDate?.ToString("dd/MM/yyyy")
                                        ?? "-")

                                    -

                                    @(item.EndDate?.ToString("dd/MM/yyyy")
                                        ?? "-")
                                </td>

                                <td>
                                    <a asp-action="Take"
                                       asp-route-scheduleId="@item.Id"
                                       asp-route-date="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       class="btn btn-primary btn-sm">
                                        Take Attendance
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>