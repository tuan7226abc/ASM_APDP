@model IEnumerable<SIMS.DatabaseContext.Entities.User>

@{
    ViewData["Title"] = "User Management";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="mb-4">
    <h1 class="h3 mb-1">User Management</h1>
    <p class="text-muted">
        Manage system accounts and roles
    </p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<div class="card">
    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <a asp-action="Create" class="btn btn-primary">
                Add User
            </a>

            <form asp-action="Index"
                  method="get"
                  class="d-flex">

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control me-2"
                       placeholder="Search username, email or role" />

                <button type="submit" class="btn btn-secondary">
                    Search
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary ms-2">
                    Clear
                </a>
            </form>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Created Date</th>
                        <th style="width: 300px;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7"
                                class="text-center text-muted">
                                No users found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Username</td>

                                <td>@item.Email</td>

                                <td>@item.Phone</td>

                                <td>
                                    @if (item.Role == "Admin")
                                    {
                                        <span class="badge bg-danger">
                                            Admin
                                        </span>
                                    }
                                    else if (item.Role == "Teacher")
                                    {
                                        <span class="badge bg-primary">
                                            Teacher
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            Student
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (item.Status == 1)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Locked
                                        </span>
                                    }
                                </td>

                                <td>
                                    @(item.CreatedAt?.ToString("dd/MM/yyyy")
                                        ?? "")
                                </td>

                                <td>
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>

                                    <form asp-action="ToggleStatus"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        @if (item.Status == 1)
                                        {
                                            <button type="submit"
                                                    class="btn btn-secondary btn-sm"
                                                    onclick="return confirm('Lock this account?')">
                                                Lock
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit"
                                                    class="btn btn-success btn-sm"
                                                    onclick="return confirm('Unlock this account?')">
                                                Unlock
                                            </button>
                                        }
                                    </form>

                                    <a asp-action="ResetPassword"
                                       asp-route-id="@item.Id"
                                       class="btn btn-info btn-sm">
                                        Reset Password
                                    </a>


                                </td>
                            </tr>
                        }
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>  