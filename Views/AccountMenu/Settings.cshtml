@{
    ViewData["Title"] = "Settings & Privacy";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="mb-4">
    <h1 class="h3 mb-1">Settings &amp; Privacy</h1>

    <p class="text-muted">
        Manage your interface and privacy preferences.
    </p>
</div>

<div class="card">
    <div class="card-body">

        <div class="form-check form-switch mb-4">

            <input class="form-check-input"
                   type="checkbox"
                   id="notificationSetting"
                   checked />

            <label class="form-check-label"
                   for="notificationSetting">
                Enable notifications
            </label>

        </div>

        <div class="form-check form-switch mb-4">

            <input class="form-check-input"
                   type="checkbox"
                   id="emailSetting" />

            <label class="form-check-label"
                   for="emailSetting">
                Receive email notifications
            </label>

        </div>

        <div class="alert alert-info mb-0">
            Username, role and password cannot be changed from this page.
            Contact an administrator when account assistance is required.
        </div>

    </div>
</div>